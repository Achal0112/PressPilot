<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="#E6D8C9"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="₹"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="#592A0E" />

            <TextView
                android:id="@+id/tvBillCustomerName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:text="Customer Name"
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="#592A0E" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="#E6D8C9" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Billing Month"
                android:textSize="14sp"
                android:textColor="#8C5A3C" />

            <TextView
                android:id="@+id/tvBillMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="September 2026"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#3E1D0A" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Delivered Days"
                android:textSize="14sp"
                android:textColor="#8C5A3C" />

            <TextView
                android:id="@+id/tvDeliveredDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 days"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#3E1D0A" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Price / Day"
                android:textSize="14sp"
                android:textColor="#8C5A3C" />

            <TextView
                android:id="@+id/tvPricePerDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹5.00"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#3E1D0A" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:orientation="horizontal"
            android:background="#FFF4E5">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL AMOUNT"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#8C5A3C" />

            <TextView
                android:id="@+id/tvTotalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹125.00"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#592A0E" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>