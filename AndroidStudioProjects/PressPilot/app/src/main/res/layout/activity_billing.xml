<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F1E8">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:background="#592A0E">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PressPilot"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#FFF8ED"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="MONTHLY BILLING"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#E5B585"
            android:letterSpacing="0.12" />

        <View
            android:layout_width="45dp"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:background="#E5B585" />

        <TextView
            android:id="@+id/tvBillingMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Billing Month"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFF8ED" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="#E6D8C9"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="₹"
                        android:textSize="23sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#592A0E" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="14dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Monthly Bills"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#592A0E" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Generate bills for all customers"
                            android:textSize="13sp"
                            android:textColor="#8C5A3C" />

                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGenerateBills"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:text="GENERATE MONTHLY BILLS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="13dp"
                    app:backgroundTint="#592A0E"
                    app:rippleColor="#E5B585" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFF4E5"
            app:cardCornerRadius="15dp"
            app:cardElevation="1dp"
            app:strokeColor="#E5B585"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Generated Bills"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#8C5A3C" />

                <TextView
                    android:id="@+id/tvBillCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bills: 0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#592A0E" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:indeterminateTint="#592A0E"
            android:visibility="gone" />


        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:padding="24dp"
            android:text="No bills available"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#8C5A3C"
            android:background="#FFF4E5"
            android:visibility="gone" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewBills"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingBottom="10dp" />

    </LinearLayout>

</LinearLayout>