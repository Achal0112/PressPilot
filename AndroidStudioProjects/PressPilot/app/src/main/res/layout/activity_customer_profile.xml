<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F1E8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:background="#592A0E">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PressPilot"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#FFF8ED"
                android:letterSpacing="0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="MY PROFILE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#E5B585"
                android:letterSpacing="0.12" />

            <View
                android:layout_width="45dp"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:background="#E5B585" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="#E6D8C9"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center_horizontal"
                        android:gravity="center"
                        android:text="P"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#592A0E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="12dp"
                        android:text="Account Information"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#592A0E" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="18dp"
                        android:background="#E6D8C9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FULL NAME"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#8C5A3C"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="18dp"
                        android:text="Loading..."
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#3E1D0A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMAIL"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#8C5A3C"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="18dp"
                        android:text="Loading..."
                        android:textSize="17sp"
                        android:textColor="#3E1D0A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOBILE NUMBER"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#8C5A3C"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvProfileMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="18dp"
                        android:text="Loading..."
                        android:textSize="17sp"
                        android:textColor="#3E1D0A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ADDRESS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#8C5A3C"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvProfileAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="18dp"
                        android:text="Loading..."
                        android:textSize="17sp"
                        android:textColor="#3E1D0A" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROLE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#8C5A3C"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvProfileRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Customer"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#592A0E" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:indeterminateTint="#592A0E" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="20dp"
                android:text="PressPilot • Newspaper Delivery Management"
                android:textSize="12sp"
                android:textColor="#795548" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>